<UserControl x:Class="WpfSistemaDeEstoque.MVVM.View.Categorias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfSistemaDeEstoque.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="111*"/>
        </Grid.RowDefinitions>


        <StackPanel>
            <Label Height="37" Content="Adicionar Categoria" FontSize="20" Margin="30,5,0,0" FontWeight="SemiBold" VerticalAlignment="Top"></Label>
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="10" Height="48" BorderBrush="Silver" BorderThickness="2" Margin="32,0,31,0" Width="545" HorizontalAlignment="Left">
                    <TextBox Background="Transparent" VerticalContentAlignment="Center" FontSize="16"  BorderBrush="{x:Null}" ></TextBox>
                </Border>
                <Border Height="50" Width="165"   CornerRadius="10" Background="#002348">
                    <Button Background="Transparent" BorderBrush="{x:Null}" Content="Adicionar" FontSize="20" Foreground="White" FontWeight="SemiBold"></Button>
                </Border>
            </StackPanel>
        </StackPanel>

        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="550" VerticalAlignment="Top" Margin="0,11,0,0" Grid.Row="1" BorderBrush="Silver" BorderThickness="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Categorias" Width="800"></DataGridTextColumn>
            </DataGrid.Columns>

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="20"></Setter>
                    <Setter Property="Height" Value="40"></Setter>
                    <Setter Property="Background" Value="#153657"></Setter>
                    <Setter Property="Foreground" Value="White"></Setter>
                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                </Style>
            </DataGrid.Resources>
        </DataGrid>


    </Grid>
</UserControl>
