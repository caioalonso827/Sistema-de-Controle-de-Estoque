<UserControl x:Class="WpfSistemaDeEstoque.MVVM.View.Produtos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfSistemaDeEstoque.MVVM.View"
             xmlns:viewModel="clr-namespace:WpfSistemaDeEstoque.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800" Loaded="User_Loaded">

    <UserControl.DataContext>
        <viewModel:ProdutosViewModels></viewModel:ProdutosViewModels>
    </UserControl.DataContext>
    
    <Grid>
        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" BorderBrush="Silver" BorderThickness="2" ItemsSource="{Binding Produtos}" >

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#153657"></Setter>
                    <Setter Property="Foreground" Value="White"></Setter>
                    <Setter Property="FontWeight" Value="Bold"></Setter>
                    <Setter Property="FontSize" Value="16"></Setter>
                    <Setter Property="Height" Value="40"></Setter>
                    <Setter Property="Padding" Value="5"></Setter>
                </Style>

                <Style TargetType="DataGridRow">
                    <Style.Setters>
                        <Setter Property="Height" Value="40"></Setter>
                        <Setter Property="FontSize" Value="16"></Setter>
                        <Setter Property="FontWeight" Value="SemiBold"></Setter>
                        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                    </Style.Setters>
                </Style>
            </DataGrid.Resources>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome do Produto" Width="350" Binding="{Binding Nome}"></DataGridTextColumn>
                <DataGridTextColumn Header="Categoria do Produto" Width="250" Binding="{Binding Categoria.Nome}"></DataGridTextColumn>
                <DataGridTextColumn Header="Quatidade em Estoque" Width="190" Binding="{Binding quantidade}"></DataGridTextColumn>
            </DataGrid.Columns>

            
        </DataGrid>
    </Grid>
</UserControl>
