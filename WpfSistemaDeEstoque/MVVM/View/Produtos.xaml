<UserControl x:Class="WpfSistemaDeEstoque.MVVM.View.Produtos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfSistemaDeEstoque.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <Grid>
        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" BorderBrush="Silver" BorderThickness="2">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#153657"></Setter>
                    <Setter Property="Foreground" Value="White"></Setter>
                    <Setter Property="FontWeight" Value="Bold"></Setter>
                    <Setter Property="FontSize" Value="16"></Setter>
                    <Setter Property="Height" Value="40"></Setter>
                    <Setter Property="Padding" Value="5"></Setter>
                </Style>
            </DataGrid.Resources>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome do Produto" Width="350"></DataGridTextColumn>
                <DataGridTextColumn Header="Categoria do Produto" Width="250"></DataGridTextColumn>
                <DataGridTextColumn Header="Quatidade em Estoque" Width="190"></DataGridTextColumn>
            </DataGrid.Columns>

            
        </DataGrid>
    </Grid>
</UserControl>
